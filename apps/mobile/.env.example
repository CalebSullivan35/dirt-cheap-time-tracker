# Same Clerk app as the web app: https://dashboard.clerk.com -> API keys
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Optional. Where the Next.js API runs. In Expo Go this defaults to port 3000 on the
# computer running `expo start`, so you usually don't need it until you deploy.
# EXPO_PUBLIC_API_URL=https://your-app.vercel.app
